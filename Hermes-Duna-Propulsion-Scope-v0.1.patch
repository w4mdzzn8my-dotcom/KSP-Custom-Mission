+using System;
+using System.Collections.Generic;
+namespace MegaCrew.DunaMission
+{
+    // Reads live KSP objects only. No part, engine, resource, throttle or stage writes.
+    public static class DunaPropulsionCapture
+    {
+        public static PropulsionSnapshot Read(Vessel vessel)
+        {
+            if(vessel==null||!vessel.loaded||vessel.packed||vessel.isEVA||vessel.parts==null)throw new InvalidOperationException("A loaded, unpacked ship is required for propulsion capture.");
+            var ids=new List<uint>();var engines=new List<PropulsionEngineSample>();var resources=new List<PropulsionResourceSample>();
+            foreach(var part in vessel.parts)
+            {
+                if(part==null||part.Modules==null||part.Resources==null)throw new InvalidOperationException("Unavailable part observation.");
+                ids.Add(part.flightID);
+                foreach(var engine in part.FindModulesImplementing<ModuleEngines>())
+                {
+                    if(engine==null||engine.propellants==null||engine.atmosphereCurve==null)throw new InvalidOperationException("Unavailable engine observation.");
+                    string fuel=engine.propellants.Count==1&&engine.propellants[0]!=null?engine.propellants[0].name:"";
+                    engines.Add(new PropulsionEngineSample(part.flightID,engine.propellants.Count,fuel,part.Modules.Contains("MultiModeEngine"),engine.EngineIgnited,engine.atmosphereCurve.Evaluate(0),engine.maxThrust*1000,engine.thrustPercentage,engine.allowRestart,engine.allowShutdown,engine.throttleLocked,engine.propellants.Count==1&&engine.propellants[0]!=null?engine.propellants[0].ratio:0));
+                }
+                foreach(PartResource resource in part.Resources)
+                {
+                    if(resource==null||resource.info==null)throw new InvalidOperationException("Unavailable resource observation.");
+                    resources.Add(new PropulsionResourceSample(part.flightID,resource.resourceName,resource.amount,resource.info.density,resource.flowState));
+                }
+            }
+            return new PropulsionSnapshot(vessel.GetTotalMass()*1000,ids,engines,resources);
+        }
+    }
+}
