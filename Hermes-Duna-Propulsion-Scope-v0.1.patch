+using System;
+using System.Collections.Generic;
+using System.Collections.ObjectModel;
+using System.Globalization;
+using System.Text;
+
+namespace MegaCrew.DunaMission
+{
+    public sealed class PropulsionEngineSample
+    {
+        public readonly uint PartId;
+        public readonly int PropellantCount;
+        public readonly string Fuel;
+        public readonly bool MultiMode, Ignited,CanRestart,CanShutdown,ThrottleLocked;
+        public readonly double VacuumIsp, MaxThrustN, LimiterPercent,FuelRatio;
+        public PropulsionEngineSample(uint partId,int count,string fuel,bool multiMode,bool ignited,double isp,double thrust,double limiter,bool canRestart=true,bool canShutdown=true,bool throttleLocked=false,double fuelRatio=1)
+        {PartId=partId;PropellantCount=count;Fuel=fuel??"";MultiMode=multiMode;Ignited=ignited;VacuumIsp=isp;MaxThrustN=thrust;LimiterPercent=limiter;CanRestart=canRestart;CanShutdown=canShutdown;ThrottleLocked=throttleLocked;FuelRatio=fuelRatio;}
+    }
+    public sealed class PropulsionResourceSample
+    {
+        public readonly uint PartId;
+        public readonly string Name;
+        public readonly double Amount,DensityTonnes;
+        public readonly bool Unlocked;
+        public PropulsionResourceSample(uint partId,string name,double amount,double density,bool unlocked)
+        {PartId=partId;Name=name??"";Amount=amount;DensityTonnes=density;Unlocked=unlocked;}
+    }
+    public sealed class PropulsionSnapshot
+    {
+        public readonly double WetKg;
+        public readonly ReadOnlyCollection<uint> PartIds;
+        public readonly ReadOnlyCollection<PropulsionEngineSample> Engines;
+        public readonly ReadOnlyCollection<PropulsionResourceSample> Resources;
+        public PropulsionSnapshot(double wet,IEnumerable<uint> ids,IEnumerable<PropulsionEngineSample> engines,IEnumerable<PropulsionResourceSample> resources)
+        {
+            if(ids==null||engines==null||resources==null)throw new ArgumentNullException("snapshot observations");
+            WetKg=wet;PartIds=new List<uint>(ids).AsReadOnly();Engines=new List<PropulsionEngineSample>(engines).AsReadOnly();Resources=new List<PropulsionResourceSample>(resources).AsReadOnly();
+        }
+    }
+    public sealed class ScopedPropulsion
+    {
+        public readonly double WetKg,RetainedKg,ThrustN,IspSeconds,UsableFuelKg,ReservedFuelKg;
+        public readonly string Fuel,Signature;
+        public readonly ReadOnlyCollection<uint> EnginePartIds,TankPartIds;
+        internal ScopedPropulsion(double wet,double fuelKg,double thrust,double isp,string fuel,string signature,List<uint> engines,List<uint> tanks)
+        {WetKg=wet;UsableFuelKg=.85*fuelKg;ReservedFuelKg=.15*fuelKg;RetainedKg=wet-UsableFuelKg;ThrustN=thrust;IspSeconds=isp;Fuel=fuel;Signature=signature;EnginePartIds=engines.AsReadOnly();TankPartIds=tanks.AsReadOnly();}
+    }
+    // Nominal read-only performance only. Selection is not proof of stock fuel
+    // connectivity, finite-burn behavior, stage isolation or burn authorization.
+    public static class DunaPropulsionScope
+    {
+        static bool Finite(double d){return !double.IsNaN(d)&&!double.IsInfinity(d);}
+        static InvalidOperationException Refuse(string reason){return new InvalidOperationException(reason);}
+        static List<uint> Selection(IEnumerable<uint> source,string label)
+        {
+            if(source==null)throw Refuse("Choose "+label+" explicitly.");
+            var set=new HashSet<uint>();var result=new List<uint>();
+            foreach(uint id in source){if(id==0||!set.Add(id))throw Refuse("Invalid or duplicate "+label+" identity.");result.Add(id);}
+            if(result.Count==0)throw Refuse("Choose "+label+" explicitly.");result.Sort();return result;
+        }
+        static string Number(double value){return value.ToString("R",CultureInfo.InvariantCulture);}
+        public static ScopedPropulsion Evaluate(PropulsionSnapshot snapshot,IEnumerable<uint> engineIds,IEnumerable<uint> tankIds)
+        {
+            if(snapshot==null||!Finite(snapshot.WetKg)||snapshot.WetKg<=0)throw Refuse("Invalid observed vessel mass.");
+            if(snapshot.PartIds.Count==0||snapshot.PartIds.Count>2000||snapshot.Engines.Count>2000||snapshot.Resources.Count>20000)throw Refuse("Unsupported snapshot size.");
+            var parts=new HashSet<uint>();foreach(uint id in snapshot.PartIds)if(id==0||!parts.Add(id))throw Refuse("Unknown or duplicate vessel part identity.");
+            var selectedEngines=Selection(engineIds,"primary engine parts");var selectedTanks=Selection(tankIds,"primary fuel tanks");
+            foreach(uint id in selectedEngines)if(!parts.Contains(id))throw Refuse("Selected engine is no longer on this vessel.");
+            foreach(uint id in selectedTanks)if(!parts.Contains(id))throw Refuse("Selected tank is no longer on this vessel.");
+            var engines=new HashSet<uint>(selectedEngines);var tanks=new HashSet<uint>(selectedTanks);var counts=new Dictionary<uint,int>();
+            double thrust=0,isp=0;string fuel=null;
+            var signatureRows=new List<string>();
+            foreach(var e in snapshot.Engines)
+            {
+                if(e==null||!parts.Contains(e.PartId))throw Refuse("Unknown engine observation.");
+                // Planning starts with all engines shut down, including payloads.
+                if(e.Ignited)throw Refuse("Shut down every attached engine before capturing a propulsion plan.");
+                signatureRows.Add("E:"+e.PartId+":"+e.PropellantCount+":"+e.Fuel+":"+e.MultiMode+":"+e.Ignited+":"+Number(e.VacuumIsp)+":"+Number(e.MaxThrustN)+":"+Number(e.LimiterPercent)+":"+e.CanRestart+":"+e.CanShutdown+":"+e.ThrottleLocked+":"+Number(e.FuelRatio));
+                if(!engines.Contains(e.PartId))continue;
+                int n;counts.TryGetValue(e.PartId,out n);counts[e.PartId]=n+1;
+                if(e.MultiMode||e.PropellantCount!=1||string.IsNullOrEmpty(e.Fuel))throw Refuse("Selected primary engines must be single-mode, single-propellant hardware.");
+                if(!e.CanRestart||!e.CanShutdown||e.ThrottleLocked)throw Refuse("Primary engines must support restart, shutdown and throttle control for the four-burn itinerary.");
+                if(!Finite(e.FuelRatio)||e.FuelRatio<=0)throw Refuse("Invalid primary propellant ratio.");
+                if(!Finite(e.VacuumIsp)||e.VacuumIsp<=0||!Finite(e.MaxThrustN)||e.MaxThrustN<=0||!Finite(e.LimiterPercent)||e.LimiterPercent<=0||e.LimiterPercent>100)throw Refuse("Invalid primary engine performance or limiter.");
+                if(fuel!=null&&(fuel!=e.Fuel||Math.Abs(isp-e.VacuumIsp)>1e-4))throw Refuse("Selected primary engines must use the same fuel and vacuum Isp.");
+                fuel=e.Fuel;isp=e.VacuumIsp;thrust+=e.MaxThrustN*e.LimiterPercent/100;
+            }
+            foreach(uint id in selectedEngines){int count;if(!counts.TryGetValue(id,out count)||count!=1)throw Refuse("Each selected part must have exactly one supported engine module.");}
+            if(!Finite(thrust)||thrust<=0||fuel==null)throw Refuse("No supported primary thrust was captured.");
+            double fuelKg=0,fuelDensity=0;var foundTanks=new HashSet<uint>();var resourceKeys=new HashSet<string>();
+            foreach(var r in snapshot.Resources)
+            {
+                if(r==null||!parts.Contains(r.PartId)||string.IsNullOrEmpty(r.Name)||!Finite(r.Amount)||r.Amount<0||!Finite(r.DensityTonnes)||r.DensityTonnes<0)throw Refuse("Invalid observed resource inventory.");
+                if(!resourceKeys.Add(r.PartId+":"+r.Name))throw Refuse("Duplicate resource observation.");
+                if(r.Name!=fuel)continue;
+                if(r.DensityTonnes<=0||(fuelDensity>0&&Math.Abs(fuelDensity-r.DensityTonnes)>1e-12))throw Refuse("Inconsistent or invalid primary fuel density.");
+                fuelDensity=r.DensityTonnes;
+                signatureRows.Add("F:"+r.PartId+":"+Number(r.Amount)+":"+Number(r.DensityTonnes)+":"+r.Unlocked);
+                if(tanks.Contains(r.PartId))
+                {
+                    foundTanks.Add(r.PartId);
+                    if(!r.Unlocked||r.DensityTonnes<=0)throw Refuse("A selected primary fuel tank is locked or has invalid density.");
+                    fuelKg+=r.Amount*r.DensityTonnes*1000;
+                }
+                else if(r.Unlocked&&r.Amount>0)throw Refuse("Unselected "+fuel+" is unlocked. Include that tank explicitly or lock it manually before planning.");
+            }
+            foreach(uint id in selectedTanks)if(!foundTanks.Contains(id))throw Refuse("A selected tank does not contain the primary fuel.");
+            if(!Finite(fuelKg)||fuelKg<=0||fuelKg>=snapshot.WetKg)throw Refuse("No valid finite primary fuel mass.");
+            signatureRows.Sort(StringComparer.Ordinal);var allParts=new List<uint>(parts);allParts.Sort();
+            var signature=new StringBuilder(Number(snapshot.WetKg));foreach(uint id in allParts)signature.Append("|P:").Append(id);
+            foreach(uint id in selectedEngines)signature.Append("|SE:").Append(id);foreach(uint id in selectedTanks)signature.Append("|ST:").Append(id);
+            foreach(string row in signatureRows)signature.Append('|').Append(row);
+            return new ScopedPropulsion(snapshot.WetKg,fuelKg,thrust,isp,fuel,signature.ToString(),selectedEngines,selectedTanks);
+        }
+    }
+}
